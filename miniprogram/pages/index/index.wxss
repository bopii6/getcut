.head {
  margin-bottom: 44rpx;
}

.brand {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--accent);
}

.slogan {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.editor-wrap {
  position: relative;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 32rpx 32rpx 56rpx;
}

.editor {
  width: 100%;
  min-height: 420rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink);
}

.ph {
  color: rgba(242, 240, 234, 0.32);
}

.counter {
  position: absolute;
  right: 32rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.label {
  margin: 48rpx 0 20rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.themes {
  display: flex;
  white-space: nowrap;
}

.theme {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  margin-right: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: transparent;
  flex-shrink: 0;
}

.theme.on {
  border-color: var(--accent);
  background: rgba(255, 212, 0, 0.06);
}

.swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.tname {
  font-size: 28rpx;
  color: var(--ink);
}

.tname {
  font-weight: 500;
}

.tdesc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
  white-space: normal;
}

.foot {
  margin-top: 60rpx;
}

.go {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 32rpx;
  font-weight: 500;
}

.go[disabled] {
  background: rgba(255, 212, 0, 0.28);
  color: rgba(10, 9, 6, 0.5);
}

.hint {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}
