.page {
  padding: 48rpx 40rpx;
}

.stage-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stage {
  font-size: 34rpx;
  font-weight: 500;
}

.pct {
  font-size: 34rpx;
  color: var(--accent);
}

.bar {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--accent);
  transition: width 0.4s linear;
}

.note {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.steps {
  margin-top: 80rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}

.step {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.player {
  width: 100%;
  height: 900rpx;
  border-radius: 16rpx;
  background: #000;
  margin-bottom: 40rpx;
}

.go {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: var(--accent);
  color: var(--accent-ink);
  font-size: 32rpx;
  font-weight: 500;
}

.sub {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 28rpx;
}

.tip {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

.fail {
  margin: 120rpx 0 60rpx;
}

.fail-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.fail-msg {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.7;
}
