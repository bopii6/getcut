// 成片主路径：一份素材包进、一条竖屏成片出（现状，2026-09-21）
// 视图问题：客户从上传到拿到片子，中间每一步由谁做、卡在哪、失败了会怎样
// 置信度：实线=代码直证；灰虚线=推断或低置信；菱形=分支判定
// 读法：从上往下是一条主干；右侧两支是「成片之后」的分岔（校验/归档、剪映草稿）
digraph filmflow {
    graph [rankdir=TB, nodesep=0.55, ranksep=0.72, fontname="Microsoft YaHei",
           labelloc=t, label="GetCut 成片主路径（现状）— system-modeler + graphviz", fontsize=19];
    node  [fontname="Microsoft YaHei", fontsize=11, style=filled, margin="0.16,0.09"];
    edge  [fontname="Microsoft YaHei", fontsize=10];

    # ── 输入端（产品边界外）──────────────────────────────
    subgraph cluster_in {
        label="输入：素材包（边界外，契约无强校验）"; style=dashed; color="#9A9A9A"; fontsize=12;
        zip   [label="素材包 zip\ncontent.json + manifest.json\n+ images/ + videos/", fillcolor="#EFEFEF", color="#9A9A9A"];
    }

    # ── 客户浏览器里发生的交互 ───────────────────────────
    subgraph cluster_browser {
        label="客户浏览器（产品的实际算力所在）"; style=bold; color="#4E7A66"; fontsize=13;
        ui    [label="/studio 或 /poc\n导入 → 内容确认 → 自动生成", shape=box3d, fillcolor="#DCE8E0"];
        comp  [label="成片台渲染工人\n@remotion/web-renderer 逐帧合成\n画面 + 配音 + BGM + 音效在页面内混好\nWebCodecs 编 h264", fillcolor="#8FB5A5", peripheries=2];
        probe [label="文字几何探针 TextProbe\nRange.getBoundingClientRect 量坐标/字号/字重/字色", fillcolor="#E8F0EA"];
        layer [label="图层导出 renderStillOnWeb\nbase.png + cards/*.png + texts.json", fillcolor="#E8F0EA"];
    }

    # ── 服务端 ───────────────────────────────────────────
    subgraph cluster_server {
        label="服务端容器（Python 3.12 + FastAPI，单进程 + 常驻线程池，无 Node 无 Chrome）"; style=bold; color="#5A6E8C"; fontsize=13;
        up    [label="POST /api/upload + /api/projects/create\n落归属 bundles.json", fillcolor="#E6EBF2"];
        bld   [label="POST /api/build\n校验项目/素材包归属 + 免费档额度\n只入队，不在请求内做重活", fillcolor="#E6EBF2"];
        prep  [label="prep 池（2 并发）\ncli.build_prep", fillcolor="#C7D3E4"];
        tts   [label="TTS 配音\ntts.synthesize 词级时间戳", fillcolor="#E6EBF2"];
        plan  [label="分镜与画面设计\nsplit_clauses → align_timeline\n→ LLM 导演 → Plan", fillcolor="#E6EBF2"];
        props [label="props.json 生产\nremotion_render.build_props\n（无 schema，隐式契约）", fillcolor="#F2E3C7"];
        hub   [label="agenthub 挂单等待\n长轮询派单 / 心跳\n失联 240s 收回，最多重派 2 次", shape=component, fillcolor="#C7D3E4", peripheries=2];
        stove [label="灶台池（6 并发）\n_render_job", fillcolor="#C7D3E4"];
        fin   [label="收片：delivered_final 为真则原样收下\n不再混音/封装（重编码会丢音轨）", fillcolor="#E6EBF2"];
        brn   [label="浏览器只交了画面轨？", shape=diamond, fillcolor="#FFF3D6", fontsize=10];
        mix   [label="兜底分支：服务端 ffmpeg\ncompose.mix_audio + mux", fillcolor="#E6EBF2", style="filled,dashed"];
    }

    # ── 外部 ─────────────────────────────────────────────
    subgraph cluster_ext {
        label="外部依赖（全部 HTTPS/WSS，失败均有兜底）"; style=dashed; color="#B08A5E"; fontsize=12;
        ds  [label="DeepSeek\n90s / 2 次重试\n失败→规则兜底", shape=hexagon, fillcolor="#F0E3D2"];
        zb  [label="智谱 glm-4v-flash\n画面复核，失败只记 warning", shape=hexagon, fillcolor="#F0E3D2"];
        tts1[label="百炼 CosyVoice\n主渠道，失败直接抛错", shape=hexagon, fillcolor="#F0E3D2"];
        tts2[label="edge-tts\n兜底渠道，3 次退避", shape=hexagon, fillcolor="#F0E3D2"];
        cos [label="腾讯云 COS\nfilms/<job前8>/\n上传失败→保留本地不抛异常", shape=hexagon, fillcolor="#F0E3D2"];
    }

    # ── 成片之后 ─────────────────────────────────────────
    subgraph cluster_after {
        label="成片之后"; style=bold; color="#8C7B62"; fontsize=13;
        ver [label="画面校验 verify.verify\n逐镜抽帧 + VLM 复核\n→ verify_report.json", fillcolor="#EDE7D9"];
        dl  [label="取片\nGET /video/{job}\n302 到 COS 限时签名链（默认 7200s）", fillcolor="#EDE7D9"];
        dy  [label="剪映分轨草稿\njianying_draft.build_zip\n8 轨：画面/底板/卡片/字幕/叠加文字/配音/BGM/音效", fillcolor="#EDE7D9"];
        flat[label="缺层退化 build_flat_content\n整条成片当单素材打包（单轨）", fillcolor="#FFF3D6", style="filled,dashed"];
        jy  [label="剪映专业版（客户机）", shape=box3d, fillcolor="#EFEFEF"];
    }

    zip  -> up    [label="选文件 / 拖包\n/intake 短链可代客投递"]
    up   -> bld   [label="点「自动生成」"]
    bld  -> prep
    prep -> tts
    tts  -> plan
    plan -> props
    prep -> ds    [label="导演/文案", style=dashed, color="#B08A5E"]
    plan -> zb    [label="备用渠道", style=dashed, color="#B08A5E", constraint=false]
    tts  -> tts1  [label="主", style=dashed, color="#B08A5E"]
    tts  -> tts2  [label="兜底", style=dashed, color="#B08A5E"]
    props -> hub  [label="待领取"]
    hub  -> comp  [label="GET /api/agent/poll?wait=1 领单\n+ /agent-media 直读素材与字体"]
    comp -> hub   [label="progress 心跳\n（响应带回 cancel 旗）", color="#4E7A66"]
    comp -> fin   [label="POST /api/agent/job/{id}/visual?final=1\n交回混好音的完整成片", color="#4E7A66", penwidth=2.5]
    hub  -> stove -> fin
    fin  -> brn
    brn  -> mix   [label="是：只交画面轨", style=dashed, color="#B08A5E"]
    brn  -> dl    [label="否（线上主路径）", color="#4E7A66", penwidth=2.5]
    mix  -> dl
    fin  -> cos   [label="_cos_archive 后台线程\n试玩任务显式不归档", style=dashed, color="#B08A5E"]
    dl   -> ver   [label="异步 _verify_bg", color="#8C7B62"]
    ver  -> cos   [label="校验完成才删本地那份", style=dashed, color="#B08A5E"]
    dl   -> dy    [label="点「剪映草稿」（高级档，402 墙）"]
    comp -> probe [label="exportMode=card", color="#4E7A66"]
    probe -> layer
    layer -> dy   [label="POST .../layer?name=\n白名单文件名落盘 .layers/", color="#4E7A66"]
    dy   -> flat  [label="任一张 PNG 缺失或过小", style=dashed, color="#B08A5E"]
    dy   -> jy    [label="草稿 zip / getcut:// 拉起"]

    # 分支/异常路径显式标出，不画成只有 happy path
    cancel [label="客户关页或刷新\n→ requeue 交还任务\n→ 启动时未完成任务批量置 failed", shape=note, fillcolor="#FFF3D6"];
    fail   [label="失败面\nstage=failed / cancelled\n免费档额度回退？（未见证据）", shape=note, fillcolor="#F7E0DC", color="#B4574A"];
    hub -> cancel [style=dotted, color="#9A9A9A", label="失联"]
    bld -> fail   [style=dotted, color="#9A9A9A", label="额度/校验", constraint=false]
}
