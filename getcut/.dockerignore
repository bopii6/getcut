# 镜像构建上下文排除项（配合 Dockerfile 使用）
.env
*_key.txt
!*_key.txt.example

# 运行时产物
work/
outputs/
uploads/
jobs.json
renderer/props*.json
renderer/*.log
renderer/*.log.err
renderer/*.mp4
renderer/*.webm
renderer/*.png
renderer/still_test.*
renderer/work/
# 成片台产物由镜像构建阶段自己打（见 Dockerfile 的 toolbundle），本地打的一律不带进上下文
renderer/browsertool-dist/
renderer/browserpoc-dist/
server_e2e.log*

# 依赖与缓存（镜像内重新安装）
renderer/node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# 媒体（素材包在运行期上传，不打进镜像）
renderer/public/media/

# 其他
.git/
.gitignore
.DS_Store
Thumbs.db
