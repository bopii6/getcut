# 复制为 .env 并填入真实值。切勿提交 .env。

DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ALIYUN_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 工作台访问令牌：设置后打开工作台需要输入一次（防公网裸奔）。
# 留空 = 不鉴权（仅建议本机自用时留空）
VIDEOGEN_TOKEN=

# 工作台扫描素材包的根目录（默认：videogen 的上级目录）
# VIDEOGEN_WORKSPACE=

# ── 并发（双通道流水线） ─────────────────────────────
# 渲染灶台路数：吃 CPU 的画面渲染并发。经验值：每 2~4 核 1 路。
# 4核4G 机器实测 2 路最优；换 16 核机后可提到 6~8 路并同步调大 SHM_SIZE。
VIDEOGEN_CONCURRENCY=2
# 备料通道路数：等外部 API（配音/分镜）的并发，2~4 足够
VIDEOGEN_PREP_CONCURRENCY=2
# 画面校验后台路数（成片交付后低优先跑，不占灶台；默认 2）
# VIDEOGEN_VERIFY_CONCURRENCY=2
# 剪映草稿后台备料路数（影子渲染，限流防抢灶台；默认 1）
# VIDEOGEN_DRAFT_CONCURRENCY=1
# Chrome 共享内存（docker-compose 用；每加 2 路灶台约 +1g）
# SHM_SIZE=1gb
