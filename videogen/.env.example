# 复制为 .env 并填入真实值。切勿提交 .env。

DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ALIYUN_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 工作台访问令牌：设置后打开工作台需要输入一次（防公网裸奔）。
# 留空 = 不鉴权（仅建议本机自用时留空）
VIDEOGEN_TOKEN=

# 工作台扫描素材包的根目录（默认：videogen 的上级目录）
# VIDEOGEN_WORKSPACE=

# ── 并发（双通道流水线） ─────────────────────────────
# 出片通道路数：画面渲染在客户的浏览器里，一路 = 一个「挂单等成片台交回来」的任务，
# 服务器只在交回后跑几秒 ffmpeg。所以它限的是同时能服务几个客户，不是 CPU——
# 要多服务人就调大，代价是每个在途任务多占一个线程和一份磁盘。
VIDEOGEN_CONCURRENCY=2
# 备料通道路数：等外部 API（配音/分镜）的并发，2~4 足够
VIDEOGEN_PREP_CONCURRENCY=2
# 画面校验后台路数（成片交付后低优先跑，不占出片通道；默认 2）
# VIDEOGEN_VERIFY_CONCURRENCY=2
# 剪映草稿后台备料路数（一串 ffmpeg 切片，限流防抢通道；默认 1）
# VIDEOGEN_DRAFT_CONCURRENCY=1

# ── 账号与付费墙（不配 SMTP 就开不了注册） ─────────────────
# 注册/忘记密码要给邮箱发 6 位验证码。下面四项留空 = 注册入口直接显示
# 「需先配置发信邮箱」，只有已存在的账号能登录——上线收钱前必须填。
# 例（QQ 邮箱）：EMAIL_SMTP_HOST=smtp.qq.com  EMAIL_SMTP_PORT=465
#               EMAIL_SMTP_USER=xxx@qq.com    EMAIL_SMTP_PASS=授权码（不是登录密码）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# 发件人（留空 = 用 EMAIL_SMTP_USER）
# EMAIL_FROM=

# 本机自测用：没配 SMTP 也允许注册，验证码直接回显在页面上。线上千万别开。
# VIDEOGEN_DEV_EMAIL=1

# 站长微信号：权益页和「联系创始人」的收款入口，人工发卡密靠它。留空显示「即将公布」
SALES_WECHAT_ID=
# 定价与免费额度（默认高级版 ¥599 买断、每天 2 条免费出片）
# PRICE_PREMIUM=599
# FREE_DAILY_BUILDS=2
# 对外访问地址：声音克隆登记时百炼要回访本站，公网部署必填
# PUBLIC_BASE_URL=https://你的域名

# 账号、卡密、每日额度三份状态默认写在 VIDEOGEN_WORKSPACE 下（容器里即 /data 卷，
# 重建镜像不丢）。第一个注册的账号自动是站长，且默认就是高级版。
